{
  "name": "@itonami/icc-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "itonami": {
    "id": "network.itonami.icc",
    "title": "OpenICC",
    "storageKey": "itonami.icc.v1",
    "description": "ローマ規程の分析手続（9 体の bot と governor）を、この端末で試します。事件の記録を入力すると、14 の憲章ゲートの判定、弁護 bot の反論、状況のまとめを返します。名指しの公表や検察官への通報はせず、外部へは何も送信しません。",
    "cljsSources": [
      "../src"
    ],
    "storeId": "network.itonami.icc"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "tauri": "tauri",
    "build:desktop": "npm run build && tauri build --no-bundle",
    "build:android": "sh scripts/android-apk.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.6"
  }
}
